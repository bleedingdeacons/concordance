<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <!--
                Admin screens: the settings page and the group-listing dashboard.
                These are WordPress admin render/menu/AJAX glue exercised through
                the admin UI at runtime, not in unit tests — the same exclusion
                the other suite plugins apply to their src/Admin layers.
            -->
            <directory>src/Admin</directory>
        </exclude>
    </source>
</phpunit>
