<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <!--
            There is deliberately no <exclude> here.

            src/Admin used to be excluded as "WordPress admin render/menu/AJAX
            glue exercised through the admin UI at runtime", which is what most
            of the suite still says. Amber disproves it — it covers its entire
            src/Admin on this same tooling — so the exclusion was habit, not
            necessity, and it hid the API-client wiring behind the settings
            screen and the dashboard widget from the coverage report.

            Both classes are covered by tests/Unit/Admin. The one thing that
            genuinely cannot run in-process is `wp_redirect(); exit;`: the stubs
            record the redirect rather than throwing, so the exit would take
            PHPUnit down with it. Where branchy logic sat in front of one of
            those, it was split into a private method
            (SettingsAdmin::resolveCacheFlushRedirect(),
            GroupListingDashboard::applySetIntergroup()) and is driven through
            reflection instead. Nothing is excluded to make a number look better.
        -->
    </source>
</phpunit>
